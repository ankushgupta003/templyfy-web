DATABASE_URL="postgresql://postgres:postgres@localhost:5432/templyfy"
JWT_SECRET="change-me-jwt-secret"
ADMIN_EMAIL="admin@templyfy.local"
ADMIN_PASSWORD="ChangeMe123!"
RAZORPAY_KEY_ID="rzp_test_key_id"
RAZORPAY_KEY_SECRET="rzp_test_key_secret"
RAZORPAY_WEBHOOK_SECRET="webhook_secret"
# Set one of the email methods below:
# 1. Free-friendly API email via Resend
RESEND_API_KEY=""
# 2. SMTP email (leave placeholder values for local JSON transport)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="smtp-user"
EMAIL_PASS="smtp-password"
EMAIL_FROM="Templyfy <noreply@example.com>"
# Public backend URL used for downloads, upload URLs, and webhook-related links.
APP_URL="http://localhost:4000"
# Optional comma-separated allowed browser origins for production, for example:
# CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
CORS_ORIGINS="http://localhost:5173"
TRUST_PROXY="false"
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="templyfy-public"
SUPABASE_PRIVATE_BUCKET="templyfy-private"
DOWNLOAD_TOKEN_SECRET="change-me-download-token-secret"
DOWNLOAD_LINK_EXPIRY_HOURS="72"
# Local dev frontend API URL. For same-domain production behind Nginx, set this to "/api" at build time.
VITE_API_URL="http://localhost:4000/api"
