{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/server.js",
    "db:generate": "node scripts/run-prisma.cjs generate --schema src/prisma/schema.prisma",
    "db:migrate": "node scripts/run-prisma.cjs migrate dev --schema src/prisma/schema.prisma",
    "db:deploy": "node scripts/run-prisma.cjs migrate deploy --schema src/prisma/schema.prisma",
    "db:seed": "node scripts/run-prisma.cjs db seed --schema src/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "node scripts/run-seed.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.49.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^8.0.7",
    "prisma": "^5.22.0",
    "razorpay": "^2.9.4",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.8.1",
    "@types/nodemailer": "^6.4.16",
    "dotenv-cli": "^7.4.2",
    "typescript": "^5.6.3"
  }
}
